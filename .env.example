# FAL_KEY: Required for fal.ai Unified AI Pipeline (GPT-5 Reasoning, Nano Banana Pro Edit, Kling 3.0 Pro)
# Obtain your key from https://fal.ai/dashboard/keys
FAL_KEY="MY_FAL_KEY"

# Gemini is used only by the server-side Project Intelligence endpoint.
# Never expose this value as a VITE_ variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
